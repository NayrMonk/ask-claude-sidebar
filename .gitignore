# ── Chrome extension build / load artifacts ──
# Generated by Chrome when loading the unpacked extension (declarativeNetRequest)
_metadata/

# Packaged builds
*.crx
*.zip
*.pem          # extension signing keys — never commit these

# ── Dependencies (if you add tooling later) ──
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ── Secrets / local config ──
.env
.env.*
secrets.json

# ── Editor / IDE ──
.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace

# ── OS cruft ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Logs ──
*.log
npm-debug.log*

